{
  "manifest_version": 3,
  "name": "YT Shorts Blocker",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-shorts-blocker@jeffreychen.dev"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
